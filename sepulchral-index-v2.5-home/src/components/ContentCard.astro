---
const {
  href,
  image,
  eyebrow,
  title,
  description,
  large = false,
  imageAlt = '',
} = Astro.props;
---
<a class:list={["content-card", { "content-card--large": large }]} href={href}>
  <div class="content-card__media">
    {image ? <img src={image} alt={imageAlt || title} loading="lazy" /> : <div class="media-fallback">SEPULCHRAL INDEX</div>}
  </div>
  <div class="content-card__body">
    {eyebrow && <div class="meta">{eyebrow}</div>}
    <h3>{title}</h3>
    {description && <p>{description}</p>}
  </div>
</a>
