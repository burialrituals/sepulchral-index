---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentCard from './ContentCard.astro';
import { hrefForEntry, labelForCollection } from '../lib/taxonomies';
const { taxonomyKey, value, entries } = Astro.props;
const names = {
  genre: 'Genre', country: 'Country', label: 'Label', 'release-type': 'Release Type', tag: 'Tag', year: 'Year'
};
const sorted = [...entries].sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<BaseLayout title={`${value} | Persecution Index`} description={`Persecution Index archive filed under ${value}.`}>
  <section class="hero hero--section taxonomy-hero"><div class="container">
    <div class="kicker">Archive / {names[taxonomyKey]}</div>
    <h1>{value}</h1>
    <p>{sorted.length} {sorted.length === 1 ? 'entry' : 'entries'} filed under this archive term.</p>
  </div></section>
  <section class="section"><div class="container">
    <div class="editorial-grid">
      {sorted.map((entry,index)=><ContentCard href={hrefForEntry(entry)} image={entry.data.image} eyebrow={`${labelForCollection(entry.collection)} · ${entry.data.country ?? 'International'}`} title={entry.data.title} description={entry.data.description} large={index===0} />)}
    </div>
  </div></section>
</BaseLayout>
