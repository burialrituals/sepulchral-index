---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getAllEntries } from '../../lib/taxonomy-data';
import { relatedScore } from '../../lib/taxonomies';
export async function getStaticPaths(){const entries=await getCollection('features');return entries.map(entry=>({params:{slug:entry.id},props:{entry}}));}
const {entry}=Astro.props; const {Content}=await render(entry); const d=entry.data;
const meta=[d.pubDate.toLocaleDateString('en-GB'),d.country??'International',d.topic??'Feature'].filter(Boolean);
const related=(await getAllEntries()).map(x=>({x,score:relatedScore(entry,x)})).filter(v=>v.score>0).sort((a,b)=>b.score-a.score).map(v=>v.x);
---
<ArticleLayout title={d.title} description={d.description} eyebrow="Feature" meta={meta} image={d.image} entry={entry} related={related}><Content /></ArticleLayout>
