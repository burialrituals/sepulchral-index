---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentCard from '../components/ContentCard.astro';
import { getCollection } from 'astro:content';
import { getTaxonomyIndex } from '../lib/taxonomy-data';

const reviews = (await getCollection('reviews')).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const news = (await getCollection('news')).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const interviews = (await getCollection('interviews')).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const features = (await getCollection('features')).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const all = [...reviews, ...news, ...interviews, ...features].sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const featuredItems = all.filter(i=>i.data.featured).slice(0,2);
if (featuredItems.length === 0 && all[0]) featuredItems.push(all[0]);
const chileItems = all.filter(i=>i.data.country==='Chile');
const linkFor = (i) => `/${i.collection}/${i.id}/`;
const typeLabel = (i) => i.collection === 'reviews' ? 'Review' : i.collection === 'news' ? 'News' : i.collection === 'interviews' ? 'Interview' : 'Feature';
const topGenres = (await getTaxonomyIndex('genre')).slice(0,8);
const topCountries = (await getTaxonomyIndex('country')).slice(0,8);
const topLabels = (await getTaxonomyIndex('label')).slice(0,8);
---
<BaseLayout>
  <section class="hero hero--compact">
    <div class="container hero-grid">
      <div>
        <div class="kicker">Independent Extreme Metal Journal & Archive · Based in Chile</div>
        <h1>Documenting the underground beyond the feed.</h1>
        <p>Selected reviews, interviews and release news, with a permanent window into Chilean and South American extreme metal.</p>
      </div>
      <aside class="hero-index" aria-label="Publication index">
        <div>INDEX / 001</div>
        <div>CHILE / MMXXVI</div>
        <div>REVIEWS · NEWS · ARCHIVE</div>
      </aside>
    </div>
  </section>

  {featuredItems.length > 0 && <section class="section section--featured"><div class="container">
    <div class="section-head"><h2>Featured</h2><span class="featured-release-note">30 OCTOBER 2026</span></div>
    <div class="featured-grid">
      {featuredItems.map((featured) => <a class="featured-card featured-card--dual" href={linkFor(featured)}>
        <div class="featured-card__media">{featured.data.image ? <img src={featured.data.image} alt={featured.data.title} /> : <div class="media-fallback">FEATURE / ARCHIVE</div>}</div>
        <div class="featured-card__body">
          <div class="meta">{typeLabel(featured)} · {featured.data.country ?? 'International'} · RELEASE {featured.data.releaseDate ? new Date(`${featured.data.releaseDate}T00:00:00`).toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' }).toUpperCase() : featured.data.pubDate.toLocaleDateString('en-GB')}</div>
          <h3>{featured.data.title}</h3>
          <p>{featured.data.description}</p>
        </div>
      </a>)}
    </div>
  </div></section>}

  {news.length > 0 && <section class="section"><div class="container">
    <div class="section-head"><h2>News</h2><a href="/news/">All news →</a></div>
    <div class="news-grid">{news.slice(0,6).map(n => <a class="news-card" href={`/news/${n.id}/`}>
      {n.data.image && <img src={n.data.image} alt={n.data.title} loading="lazy" />}
      <div class="news-card__body"><div class="meta">{n.data.pubDate.toLocaleDateString('en-GB')} · {n.data.country ?? 'International'}</div><h3>{n.data.title}</h3><p>{n.data.description}</p></div>
    </a>)}</div>
  </div></section>}

  {chileItems.length > 0 && <section class="section chile-section"><div class="container">
    <div class="chile-intro">
      <div><div class="kicker">CHL / FIELD INDEX</div><h2>From Chile</h2></div>
      <p>A permanent window into Chilean extreme metal for an international readership.</p>
      <a class="section-link" href="/from-chile/">Explore Chile →</a>
    </div>
    <div class="editorial-grid editorial-grid--chile">
      {chileItems.slice(0,3).map((i) => <ContentCard href={linkFor(i)} image={i.data.image} eyebrow={`Chile · ${typeLabel(i)}`} title={i.data.title} description={i.data.description} />)}
    </div>
  </div></section>}

  <section class="section browse-teaser"><div class="container">
    <div class="section-head"><div><div class="kicker">Archive navigation</div><h2>Browse the Index</h2></div><a href="/browse/">Browse full index →</a></div>
    <div class="browse-columns">
      <div class="browse-widget"><h3>Genres</h3>{topGenres.map(x=><a href={`/genre/${x.slug}/`}><span>{x.value}</span><small>{x.count}</small></a>)}</div>
      <div class="browse-widget"><h3>Countries</h3>{topCountries.map(x=><a href={`/country/${x.slug}/`}><span>{x.value}</span><small>{x.count}</small></a>)}</div>
      <div class="browse-widget"><h3>Labels</h3>{topLabels.map(x=><a href={`/label/${x.slug}/`}><span>{x.value}</span><small>{x.count}</small></a>)}</div>
    </div>
  </div></section>
</BaseLayout>
