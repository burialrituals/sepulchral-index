---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentCard from '../components/ContentCard.astro';
import { getCollection } from 'astro:content';

const reviews = (await getCollection('reviews')).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const news = (await getCollection('news')).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const interviews = (await getCollection('interviews')).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const features = (await getCollection('features')).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const all = [...reviews, ...news, ...interviews, ...features].sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const featured = all.find(i=>i.data.featured) ?? all[0];
const chileItems = all.filter(i=>i.data.country==='Chile');
const linkFor = (i) => `/${i.collection}/${i.id}/`;
const typeLabel = (i) => i.collection === 'reviews' ? 'Review' : i.collection === 'news' ? 'News' : i.collection === 'interviews' ? 'Interview' : 'Feature';
---
<BaseLayout>
  <section class="hero hero--compact">
    <div class="container hero-grid">
      <div>
        <div class="kicker">Independent Extreme Metal Journal & Archive · Based in Chile</div>
        <h1>Documenting the underground beyond the feed.</h1>
        <p>Selected reviews, interviews and release news, with a permanent window into Chilean and South American extreme metal.</p>
      </div>
      <aside class="hero-index" aria-label="Publication index">
        <div>INDEX / 001</div>
        <div>CHILE / MMXXVI</div>
        <div>REVIEWS · NEWS · ARCHIVE</div>
      </aside>
    </div>
  </section>

  {featured && <section class="section section--featured"><div class="container">
    <div class="section-head"><h2>Featured</h2><a href={linkFor(featured)}>Read {typeLabel(featured).toLowerCase()} →</a></div>
    <a class="featured-card" href={linkFor(featured)}>
      <div class="featured-card__media">{featured.data.image ? <img src={featured.data.image} alt={featured.data.title} /> : <div class="media-fallback">FEATURE / ARCHIVE</div>}</div>
      <div class="featured-card__body">
        <div class="meta">{typeLabel(featured)} · {featured.data.country ?? 'International'} · {featured.data.pubDate.toLocaleDateString('en-GB')}</div>
        <h3>{featured.data.title}</h3>
        <p>{featured.data.description}</p>
      </div>
    </a>
  </div></section>}

  {reviews.length > 0 && <section class="section"><div class="container">
    <div class="section-head"><h2>Latest Reviews</h2><a href="/reviews/">All reviews →</a></div>
    <div class="editorial-grid">
      {reviews.slice(0,3).map((r,index) => <ContentCard href={`/reviews/${r.id}/`} image={r.data.image} imageAlt={`${r.data.band} — ${r.data.release}`} eyebrow={`${r.data.country} · ${r.data.genres.join(' / ')}`} title={r.data.title} description={r.data.description} large={index===0} />)}
    </div>
  </div></section>}

  {chileItems.length > 0 && <section class="section chile-section"><div class="container">
    <div class="chile-intro">
      <div><div class="kicker">CHL / FIELD INDEX</div><h2>From Chile</h2></div>
      <p>A permanent window into Chilean extreme metal for an international readership.</p>
      <a class="section-link" href="/from-chile/">Explore Chile →</a>
    </div>
    <div class="editorial-grid editorial-grid--chile">
      {chileItems.slice(0,3).map((i,index) => <ContentCard href={linkFor(i)} image={i.data.image} eyebrow={`Chile · ${typeLabel(i)}`} title={i.data.title} description={i.data.description} large={index===0} />)}
    </div>
  </div></section>}

  {interviews.length > 0 && <section class="section"><div class="container">
    <div class="section-head"><h2>Latest Interviews</h2><a href="/interviews/">All interviews →</a></div>
    <div class="editorial-grid">{interviews.slice(0,3).map((i,index)=><ContentCard href={`/interviews/${i.id}/`} image={i.data.image} eyebrow={`${i.data.country} · Interview`} title={i.data.title} description={i.data.description} large={index===0} />)}</div>
  </div></section>}

  {news.length > 0 && <section class="section"><div class="container">
    <div class="section-head"><h2>Signals / News</h2><a href="/news/">All news →</a></div>
    <div class="news-grid">{news.slice(0,4).map(n => <a class="news-card" href={`/news/${n.id}/`}>
      {n.data.image && <img src={n.data.image} alt={n.data.title} loading="lazy" />}
      <div class="news-card__body"><div class="meta">{n.data.pubDate.toLocaleDateString('en-GB')} · {n.data.country ?? 'International'}</div><h3>{n.data.title}</h3><p>{n.data.description}</p></div>
    </a>)}</div>
  </div></section>}

  <section class="section"><div class="container archive-teaser">
    <div><div class="kicker">Print lineage</div><h2>Burial Rituals News Archive</h2></div>
    <p>Sixteen issues of the printed underground newsletter are preserved here as part of the publication's history.</p>
    <a class="section-link" href="/archive/burial-rituals/">View archive →</a>
  </div></section>
</BaseLayout>
