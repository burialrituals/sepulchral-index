---
import { getCollection, render } from 'astro:content'; import ArticleLayout from '../../layouts/ArticleLayout.astro';
export async function getStaticPaths(){const entries=await getCollection('interviews');return entries.map(entry=>({params:{slug:entry.id},props:{entry}}));}
const {entry}=Astro.props; const {Content}=await render(entry); const d=entry.data;
---
<ArticleLayout title={d.title} description={d.description} eyebrow="Interview" meta={[d.country,d.pubDate.toLocaleDateString('en-GB'),`Interview by ${d.author}`]} badges={d.genres}><Content /></ArticleLayout>
