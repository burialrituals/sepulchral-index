---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { getCollection } from 'astro:content';
const items=(await getCollection('interviews')).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<BaseLayout title="Interviews | Sepulchral Index"><section class="hero"><div class="container"><div class="kicker">Interviews</div><h1>Direct voices.</h1><p>Conversations with bands and people shaping the extreme metal underground.</p></div></section><section class="section"><div class="container"><div class="grid">{items.map(i=><a class="card" href={`/interviews/${i.id}/`}><div class="card-media">INTERVIEW<br/>{i.data.band}</div><div class="card-body"><div class="meta">{i.data.country} · {i.data.genres.join(' / ')}</div><h3>{i.data.title}</h3><p>{i.data.description}</p></div></a>)}</div></div></section></BaseLayout>
