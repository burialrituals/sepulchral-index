---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { getCollection } from 'astro:content';
const items=(await getCollection('news')).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<BaseLayout title="News | Sepulchral Index"><section class="hero"><div class="container"><div class="kicker">News</div><h1>Signals from the underground.</h1><p>Selected release, label and scene news without press-release bloat.</p></div></section><section class="section"><div class="container"><div class="list">{items.map(n=><a class="list-item" href={`/news/${n.id}/`}><div class="date">{n.data.pubDate.toLocaleDateString('en-GB')}</div><div><h3>{n.data.title}</h3><p>{n.data.description}</p></div></a>)}</div></div></section></BaseLayout>
