---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { getCollection } from 'astro:content';
const reviews=(await getCollection('reviews')).filter(x=>x.data.country==='Chile').sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const interviews=(await getCollection('interviews')).filter(x=>x.data.country==='Chile').sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<BaseLayout title="From Chile | Sepulchral Index" description="A dedicated window into Chilean extreme metal."><section class="hero"><div class="container"><div class="kicker">From Chile</div><h1>Chile is the base, not the border.</h1><p>A permanent section for Chilean extreme metal: releases, interviews, labels, archive material and future scene reports.</p></div></section><section class="section"><div class="container"><div class="section-head"><h2>Recent coverage</h2></div><div class="grid">{[...reviews,...interviews].slice(0,6).map(i=><a class="card" href={`/${i.collection}/${i.id}/`}><div class="card-media">FROM CHILE</div><div class="card-body"><div class="meta">Chile · {i.collection}</div><h3>{i.data.title}</h3><p>{i.data.description}</p></div></a>)}</div></div></section></BaseLayout>
