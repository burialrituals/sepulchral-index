---
import BaseLayout from './BaseLayout.astro';
const { title, description, eyebrow, meta = [], badges = [], image } = Astro.props;
---
<BaseLayout title={`${title} | Sepulchral Index`} description={description} image={image}>
  <article class="article">
    <div class="kicker">{eyebrow}</div>
    <h1>{title}</h1>
    {image && <figure class="article-hero"><img src={image} alt={title} /></figure>}
    <div class="article-meta">
      {meta.map((item) => <div>{item}</div>)}
    </div>
    {badges.length > 0 && <div class="badges">{badges.map((b) => <span class="badge">{b}</span>)}</div>}
    <div class="article-content"><slot /></div>
  </article>
</BaseLayout>
