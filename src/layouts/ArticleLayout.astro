---
import BaseLayout from './BaseLayout.astro';
import TaxonomyLinks from '../components/TaxonomyLinks.astro';
import { hrefForEntry, labelForCollection } from '../lib/taxonomies';
const { title, description, eyebrow, meta = [], image, entry, related = [] } = Astro.props;
---
<BaseLayout title={`${title} | Persecution Index`} description={description} image={image}>
  <article class="article">
    <div class="kicker">{eyebrow}</div>
    <h1>{title}</h1>
    {image && <figure class="article-hero"><img src={image} alt={title} /></figure>}
    <div class="article-meta">
      {meta.map((item) => <div>{item}</div>)}
    </div>
    {entry && <div class="filed-under"><span>Filed under</span><TaxonomyLinks entry={entry} /></div>}
    <div class="article-content"><slot /></div>
  </article>
  {related.length > 0 && <section class="section related-section"><div class="container">
    <div class="section-head"><h2>Related entries</h2><a href="/browse/">Browse archive →</a></div>
    <div class="related-grid">
      {related.slice(0,3).map((item) => (
        <a class="related-card" href={hrefForEntry(item)}>
          <div class="related-card__media">
            {item.data.image ? <img src={item.data.image} alt={item.data.title} loading="lazy" /> : <div class="media-fallback">PERSECUTION INDEX</div>}
          </div>
          <div class="related-card__body">
            <div class="meta">{`${labelForCollection(item.collection)} · ${item.data.country ?? 'International'}`}</div>
            <h3>{item.data.title}</h3>
            {item.data.description && <p>{item.data.description}</p>}
          </div>
        </a>
      ))}
    </div>
  </div></section>}
</BaseLayout>
